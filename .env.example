# ===== CatVTON API (api_server.py) =====
# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# --- Mạng & bảo mật ---
# Chỉ lắng nghe trên localhost; Cloudflare Tunnel sẽ chuyển tiếp từ Internet vào đây.
CATVTON_HOST=127.0.0.1
CATVTON_PORT=8000
# Khóa bí mật dùng chung với Shop_API (biến CATVTON_API_KEY trên Render). Bắt buộc, >= 24 ký tự.
# Tạo ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
CATVTON_API_KEY=

# --- Hàng đợi & giới hạn ---
MAX_CONCURRENT_INFERENCE=1
TRYON_MAX_QUEUE_SIZE=5
# Giây tối đa cho MỘT tác vụ kể từ lúc bắt đầu xử lý trên GPU
MAX_JOB_TIMEOUT=180
# Giây giữ ảnh kết quả trong RAM nếu Shop_API chưa lấy
TRYON_RESULT_TTL=3600
# Giây giữ thêm sau lần lấy ảnh đầu tiên (để người dùng xem lại / tải về), sau đó tự xóa
TRYON_RESULT_DELIVERED_GRACE=300
# Giây giữ thông tin (không có ảnh) của tác vụ đã kết thúc
TRYON_JOB_RETENTION=3600
# Số ảnh kết quả tối đa giữ đồng thời trong RAM
TRYON_MAX_STORED_RESULTS=20
# Dung lượng tối đa mỗi ảnh (byte) và số điểm ảnh tối đa
TRYON_UPLOAD_MAX_SIZE=10485760
TRYON_MAX_IMAGE_PIXELS=50000000

# --- Model ---
CATVTON_BASE_MODEL=booksforcharlie/stable-diffusion-inpainting
CATVTON_ATTN_REPO=zhengchong/CatVTON
# bf16 phù hợp RTX 30xx/40xx (RTX 4060 hỗ trợ). GPU cũ hơn dùng fp16.
CATVTON_MIXED_PRECISION=bf16
# Độ phân giải inference (chia hết cho 8). Giảm (vd 576x768) nếu thiếu VRAM.
TRYON_WIDTH=768
TRYON_HEIGHT=1024
TRYON_DEFAULT_STEPS=30
TRYON_MIN_STEPS=10
TRYON_MAX_STEPS=50
TRYON_DEFAULT_GUIDANCE=2.5
# -1 = ngẫu nhiên mỗi lần
TRYON_DEFAULT_SEED=42
# Thiết bị chạy DensePose + SCHP: cuda (nhanh) hoặc cpu (tiết kiệm VRAM, chậm hơn)
TRYON_MASKER_DEVICE=cuda
# 1 = bật VAE tiling để giảm VRAM đỉnh
TRYON_VAE_TILING=0
# Giữ 0: bộ lọc an toàn (NSFW) của pipeline gốc vẫn bật
TRYON_SKIP_SAFETY_CHECK=0
